# Ybex — every setting the app reads (session 58 v334).
# The hosting tool (AI Studio / Cloud Run) asks for the keys listed in THIS file — before v334 the file was missing,
# so only GEMINI_API_KEY was asked. Copy to .env for local runs. Never commit real values.
# REQUIRED = the app breaks or a main feature is off without it. Full guide: docs/ENV_KEYS.md

# ── Core (REQUIRED) ───────────────────────────────────────────────────────────────────────────────
# Supabase → Project settings → API
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""
# Same two values again for the browser build (Vite reads VITE_* at build time)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Public address of the app, no trailing slash (links in emails, Google/Apple sign-in return address)
# v337: use the address that really opens the app TODAY (ybexapp.ai.studio). Switch all three to https://ybexmedia.in
# only when ybexmedia.in opens the app (Cloudflare step 6 in docs/DOMAIN_CLOUDFLARE.md).
APP_URL="https://ybexapp.ai.studio"
SITE_URL="https://ybexapp.ai.studio"
VITE_PUBLIC_SITE_URL="https://ybexapp.ai.studio"
# iPhone app server (optional — default https://ybexapp.ai.studio, see src/lib/native.js)
VITE_API_ORIGIN=""
# Same long random string in the Cloudflare Worker (docs/DOMAIN_CLOUDFLARE.md) — lets the server see the real visitor IP
PROXY_SHARED_SECRET=""
# Long random strings (any password generator, 40+ characters). Keep them the same between deploys.
SESSION_SECRET=""
OAUTH_STATE_SECRET=""
MEDIA_KEY_SECRET=""
EMAIL_LINK_SECRET=""
CRON_SECRET=""
NODE_ENV="production"

# ── Ybex Eva (REQUIRED for Eva) ──────────────────────────────────────────────────────────────────
# Google AI Studio → Get API key
GEMINI_API_KEY=""
# Optional: model name / daily message limit per user
ASSIST_MODEL=""
ASSIST_DAILY_LIMIT=""

# ── Email (REQUIRED: OTP codes, payouts, notices) ────────────────────────────────────────────────
# resend.com → API Keys. The from-address must be on a domain verified in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Ybex <no-reply@ybexmedia.in>"
# Leave EMPTY in production (when set, a failed email does not block sign-up — only for testing)
RESEND_ALLOW_FALLBACK=""
# Where admin alerts (payout due, refunds, KYC, new signups) go
ADMIN_EMAIL=""
ADMIN_ALERT_EMAIL=""
# Max admin broadcast emails a day (default 80)
BROADCAST_DAILY_LIMIT=""

# ── Payments — Razorpay (REQUIRED) ───────────────────────────────────────────────────────────────
# Razorpay dashboard → Settings → API keys (use LIVE keys for launch)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Razorpay → Settings → Webhooks → secret of the webhook pointing to https://<APP_URL>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""
# "false" for real money. "true" only on a test server.
PAYMENTS_TEST_MODE="false"

# ── Sign in with Google ──────────────────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorised redirect URI: https://<APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Sign in with Apple (needed for the iPhone App Store because Google sign-in is offered) ───────
# Apple Developer → Identifiers → Services ID (e.g. in.ybexmedia.signin), enable Sign in with Apple,
# Return URL: https://<APP_URL>/api/auth/oauth/apple/callback . Only the Services ID is needed here.
APPLE_CLIENT_ID=""

# ── Phone push notifications ─────────────────────────────────────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys   (keep the same keys forever, or everyone must re-allow)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@ybexmedia.in"

# ── WhatsApp reminders (optional — Meta WhatsApp Cloud API) ──────────────────────────────────────
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── Optional / admin ─────────────────────────────────────────────────────────────────────────────
# Hidden quick admin entry /admin/ybx — OFF unless set (6+ characters)
ADMIN_QUICK_PIN=""
# Extra allowed web origins, comma separated
CORS_ORIGINS=""
# Android app link for the "Get the app" button once it's on Play Store
VITE_PLAY_STORE_URL=""
VITE_APP_VERSION=""

# ── iPhone App Store app (v336) ──────────────────────────────────────────────────────────────────
# Apple push: developer.apple.com → Keys → "+" → Apple Push Notifications service → download .p8 (once!)
APNS_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.ybex.app"
# "true" for App Store / TestFlight builds, "false" only while running from Xcode
APNS_PRODUCTION="true"
# Live update of the iPhone app's web build: "true" pauses it; IOS_OTA_MIN_BUILD = lowest App Store version that may update
IOS_OTA_OFF=""
IOS_OTA_MIN_BUILD=""

# ── Must stay OFF in production (leave empty) ────────────────────────────────────────────────────
DEMO_LOGIN=""
DEMO_SEED=""
# "off" in production (on = shows OTP codes on screen for testing)
OTP_ECHO="off"
SEO_NOINDEX=""
YBEX_SYNC_BLOB=""
